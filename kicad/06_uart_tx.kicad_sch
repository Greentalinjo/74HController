	(text "A 74HC165 shifts towards Q7 and presents input D7 first, so the\nparallel inputs are loaded in reverse frame order.\nFrame:  0 (start) . b0 b1 b2 b3 b4 b5 b6 . make/break . 1 (stop)\nThat is a genuine 8-N-1 byte whose bit 7 carries press/release.\n \n~PL is tied straight to BUSY: while idle the registers are held in\nparallel-load, so the start bit is standing ready on Q7 and appears\nthe instant BUSY rises.  ~CE is tied low - the asynchronous load\noverrides the clock, so no shift-inhibit gating is needed."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "3af99c20-c937-5a52-bf9f-4c362d5613ac")
	)
	(text "UART TRANSMITTER  -  10-bit frame from two 74HC165"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "40d3591d-8ade-51cf-bfe0-5dc98c476104")
	)
	(text "TX_TTL = TX_SR OR nBUSY OR SUPPRESS.\nnBUSY parks the line high between frames; SUPPRESS blanks a whole\nrelease frame when JP3 is open."
		(exclude_from_sim no)
		(at 95 250 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "706b9913-fe05-568d-ad44-1ade2218d07d")
	)
	(text "U15: start bit + ASCII b0..b6\nD7=start(0) D6=b0 D5=b1 D4=b2\nD3=b3 D2=b4 D1=b5 D0=b6"
		(exclude_from_sim no)
		(at 55 140 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "97706df4-b333-5566-8994-596f98765e1d")
	)
	(text "U16: make/break + stop + idle ones\nD7=make/break  D6=stop(1)\nD5..D0 = 1 so the line idles high\nafter the frame."
		(exclude_from_sim no)
		(at 200 140 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "b50b6ffd-4343-5045-853e-736563a096b2")
	)
	(text "TX OUTPUT GATE"
		(exclude_from_sim no)
		(at 193.04 175 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
