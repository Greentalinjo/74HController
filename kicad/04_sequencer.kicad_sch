	(text "BREAK CODE OPTION"
		(exclude_from_sim no)
		(at 300 190 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "015d7e63-8568-5fb6-b666-0772f076a61e")
	)
	(text "~MR = BUSY: the sequencer sits at state 0\nwhenever the transmitter is idle."
		(exclude_from_sim no)
		(at 270 130 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "3205b712-a0a4-5da8-9463-4926229cea91")
	)
	(text "MKBRK = LIVE AND BRK_EN  -> frame bit 7.\nWith JP3 open (press only) bit 7 is forced to 0, so the console\nreceives clean 7-bit ASCII rather than 0x80|code.  With JP3\nfitted, bit 7 is 1 on press and 0 on release."
		(exclude_from_sim no)
		(at 165.1 236 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "38234d6b-6ae6-5db3-9766-b18905e7dbfd")
	)
	(text "All of this runs on nCLK (the falling edge of the bit clock).\n \nf0   BUSY set from DIFF.  Scan counter freezes on the changed key.\n     ~PL of the 74HC165s releases, so the START bit is already on TX.\nf1..f9  nine shifts: b0..b6, make/break, stop.  Ten bit times total.\nf10  sequencer state 10 -> ~S10 pulses the 74HC259 write enable, so\n     the new key state is stored.  DIFF collapses to 0.\nf11  With DIFF now 0, U9A clocks BUSY low from its own D input.\n     The scanner resumes on the next CLK edge.  Total halt: 11 bit\n     times - the frame plus the one cell that writes the latch.\n \nSTATES 11-12 ARE A LOCK-UP ESCAPE, NOT PART OF THE NORMAL PATH.\nThey only run if DIFF somehow fails to collapse at state 10, which\nwould otherwise leave BUSY stuck and the scanner frozen for good.\nThen ~S11 goes low, U9B captures it on the next edge and drives\nSEQ_HOLD low, asynchronously clearing BUSY at f12.  Clearing BUSY\nclears the sequencer, so ~S11 goes away again - registering it in\nU9B is what holds the clear asserted for a full bit time instead of\none propagation delay, and removes the self-clearing race.\nFault injection in tools/simulate.py jams DIFF high and confirms the\nscanner is freed after 12 bit times."
		(exclude_from_sim no)
		(at 76.2 24 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "455ad23c-5e45-5e11-b11e-88e4e26ed961")
	)
	(text "SUPPRESS = nLIVE AND BRK_DIS\n(blank the frame on key RELEASE when break codes are disabled)"
		(exclude_from_sim no)
		(at 110 190 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "6dba63d7-94f9-5cef-a59a-b7f0f622aad8")
	)
	(text "TRANSMIT SEQUENCER AND CONTROL"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7882f83e-3dfe-5db6-8e49-f382e036be82")
	)
	(text "JP3 OPEN  (default): press only.  Bit 7 always 0, release frames\n                     are blanked.  This is what a RouterOS\n                     console wants - 0x80|ASCII is garbage to it.\nJP3 FITTED: full make/break.  Bit 7 = 1 on press, 0 on release."
		(exclude_from_sim no)
		(at 270 230.08 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "7aad4a73-b35a-5472-ab96-a102496ae4e0")
	)
	(text "U9B = clear hold"
		(exclude_from_sim no)
		(at 34 174 0)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9fb8e2b3-4b3f-5e60-b5ab-c52704fdd647")
	)
	(text "U9A = BUSY"
		(exclude_from_sim no)
		(at 40 114 0)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b99526da-17b6-5ea7-a9c2-6528f6cc4dfc")
	)
	(text "BUSY_CLR_n = POR_n AND SEQ_HOLD"
		(exclude_from_sim no)
		(at 120 145 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "bc56f939-1776-5847-9f3d-b0c1eabc3172")
	)
	(text "E2 = SQ3, so Y0..Y7 decode states 8..15.\nOnly ~Y2 (=state 10) and ~Y3 (=state 11) are used;\nno inverter is needed because ~Y2 drives the\nactive-low write enable of the 74HC259 directly."
		(exclude_from_sim no)
		(at 296 148 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "d7d47068-3dce-5d36-b362-c54885719e91")
	)
