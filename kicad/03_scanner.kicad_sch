	(text "LIVE = physical state of the addressed key."
		(exclude_from_sim no)
		(at 140 108 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "3f710d5e-5c55-569a-bf4b-553e68f501db")
	)
	(text "DIFF = LIVE xor STORED"
		(exclude_from_sim no)
		(at 40.64 166.37 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "5a3b38dc-b0ec-5c7f-8f40-442ca3ccf0ec")
	)
	(text "Spare XOR gates parked\nwith both inputs at GND."
		(exclude_from_sim no)
		(at 195 258 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "63736be5-5187-5a1a-9714-205eced9e770")
	)
	(text "Counts on CLK rising edges.  CEP/CET = nBUSY:\nthe counter is stopped by a synchronous ENABLE,\nnever by gating the clock.  Q3/TC unused."
		(exclude_from_sim no)
		(at 25 105 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "7fc4c2ef-5171-556c-a5f2-853bcd910502")
	)
	(text "U8B: an XOR with one input tied high is an inverter.\nBRK_EN = NOT BRK_DIS, used to gate frame bit 7 (sheet 5)."
		(exclude_from_sim no)
		(at 111.76 243.84 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "860e5b4d-b8ee-52aa-a023-40e1fe20d62b")
	)
	(text "SCANNER, STATE MEMORY AND CHANGE DETECTION"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ba7ea0c3-50ea-5383-ab58-31b20ba19e5d")
	)
	(text "U7 is the part the original sketch was missing.  A 74HC259 has\nno read-back port: its 8 latches are only visible as 8 parallel\noutputs, so a second multiplexer is required to look at the one\nbit the scanner is currently addressing."
		(exclude_from_sim no)
		(at 120 212 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "bf5e7d8b-1ef6-5230-a24b-ea41dca6f69c")
	)
	(text "Written once per frame, during sequencer state 10,\ni.e. after the stop bit has been shifted out.\nPOR_n clears all 8 bits to 0 at power-up so the\nstored state matches \"no key pressed\"."
		(exclude_from_sim no)
		(at 270 105 0)
		(effects
			(font
				(size 1.9 1.9)
			)
			(justify left top)
		)
		(uuid "ccb7bd7b-ee26-57c7-ba89-8383d418b0b5")
	)
