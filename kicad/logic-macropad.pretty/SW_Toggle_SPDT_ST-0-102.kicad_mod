(footprint "SW_Toggle_SPDT_ST-0-102"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "YUEN FUNG ST-0-102 sub-miniature SPDT toggle switch, ON-ON, 3A 125VAC. Three in-line PC pins at 2.54mm pitch, body 8.3x5.2mm, M5x0.5 bushing OD 6.0, lever 23.6mm overall. Pin 2 = common, per the vendor table: POS.1 makes 2-1 and POS.3 makes 2-3. Which lever direction is which is not worth deriving here - pin 3 is left open, so whichever way turns the board on, is on. Drop-in for the SMTS-102 apart from the 2.54 vs 2.5 pitch. LCSC C1788487.")
  (tags "toggle switch SPDT ST-0-102 SMTS-102 MTS ON-ON")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -4.2) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "SW_Toggle_SPDT_ST-0-102" (at 0 4.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "1<-lever->3" (at 0 -1.8) (layer "F.Fab")
    (effects (font (size 0.6 0.6) (thickness 0.1)))
  )
  (fp_line (start -4.26 -2.71) (end 4.26 -2.71) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -4.26 2.71) (end 4.26 2.71) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
