  (fp_circle (center -2.54 -3.4) (end -2.39 -3.4) (stroke (width 0.3) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_line (start -4.4 -2.85) (end 4.4 -2.85) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -4.4 2.85) (end 4.4 2.85) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
